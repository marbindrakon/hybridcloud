{
  "name": "@hybridsovereign/admin-console-plugin",
  "version": "1.2.31",
  "private": true,
  "description": "OpenShift Console dynamic plugin for Hybrid Sovereign admin views",
  "main": "dist/plugin-entry.js",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "typecheck": "tsc --noEmit"
  },
  "consolePlugin": {
    "name": "sovereign-admin-plugin",
    "version": "1.2.31",
    "displayName": "Sovereign Cloud",
    "description": "Sovereign Cloud perspective: platform pages for platform administrators",
    "exposedModules": {
      "ShcConsolePage": "./src/ShcConsolePage.tsx",
      "perspective": "./src/perspective.tsx",
      "platformAdminFlag": "./src/platformAdminFlag.ts"
    }
  },
  "dependencies": {
    "@hybridsovereign/shared": "*",
    "@openshift-console/dynamic-plugin-sdk": "^1.8.0",
    "@patternfly/react-core": "^6.4.0",
    "@patternfly/react-icons": "^6.4.0",
    "@patternfly/react-table": "^6.4.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk-webpack": "^1.2.0",
    "@types/react": "^17.0.80",
    "@types/react-dom": "^17.0.25",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  }
}
