#!/bin/bash
# shc-fabric-apply: realize one fabric instance on a border gateway node from /etc/shc-fabric/<instance>.json.
# Installed and run by the platform's HybridFabric/CloudGateway jobs, and at boot by shc-fabric-apply@<instance>
# before FRR starts. Idempotent; the last line says whether anything changed ("changed=yes|no").
#   shc-fabric-apply <instance> [up|down]
# instance type "root" (the border gateway's own instance, root namespace):
#   MPLS (modules, platform_labels), the node-local core bridge with the link address and a fixed MAC (a Linux bridge
#   otherwise takes a port's MAC whenever ports change, and IS-IS on it keeps the old one: prints bridge-mac=changed
#   when it had to set it, so FRR can be restarted), the provider-edge loopback on lo; other addresses from the
#   fabric's core prefixes are removed.
#   egress {vrf, table, parent, mtu, address, gateway, deny, allow, platformSources, platformPorts, networks: [{vrf,
#   table, zone, xe, xo, xeAddr, xoAddr, nat, platform}]} (provider internet egress and platform reach; absent =
#   none): a VRF <vrf> with a macvlan egress0 on <parent> (the site network the hand-off uses) holding <address>; per
#   network a VRF e<n> (FRR imports the network's VPN routes into it) and a veth xe<n> (in e<n>) / xo<n> (in <vrf>),
#   proxy ARP on egress0 for each network's NAT address (networks with internet egress), and the nftables table ip
#   shc_egress: conntrack zone per network, source NAT on xe<n>, nothing to deny destinations, nothing unsolicited
#   into a network - except the platform's sources to a network's platform prefixes on platformPorts (and their
#   replies, stateless: they may return through the other node), never source-NATed. Veths of networks no longer
#   listed are removed. Routes are FRR's (staticd).
#   attachments {vlanPool: [start, end], parents: [interface], platformSources, circuits: [{circuit, device, parent,
#   vlan, mtu, vrf, table, zone, address, link, nat}]} (attachment circuits; absent = none): per circuit a VLAN
#   device <parent>.<vlan> in the network's root VRF e<n> (created when missing; the same VRF as the network's
#   egress) holding the node's address on the circuit's link, with strict reverse path filtering and no IPv6; the
#   nftables table ip shc_attach: the network's conntrack zone on the device, nothing to the node itself from it but
#   BGP from the link, BFD and ICMP, nothing to the platform's sources and, unless nat, nothing into the egress veth.
#   VLAN devices in a root VRF, or on a listed parent with a VLAN in vlanPool, that aren't listed are removed.
#   Root VRFs e<digits> that neither the egress nor a circuit lists are removed with their devices.
# instance type "gateway" (a CloudGateway, network namespace <netns>):
#   the namespace (forwarding, MPLS), the provider-edge loopback, the site's underlay VLAN on the trunk moved into
#   the namespace with the gateway's site address, and a veth from the namespace's core0 (link address) to the core
#   bridge. down deletes the veth and the namespace (the VLAN device goes with it). FRR's routes are FRR's own
#   (staticd), never kernel routes set here.
#   vrfs [{name, vni, mtu}]: one Linux VRF per network placed at the site (table = VNI) with its layer 3 VNI: a
#   bridge br<vni> in the VRF and a VXLAN device vx<vni> from the gateway's site address; VRFs named t<digits> that
#   are no longer listed are removed with their devices.
#   wireguard {device, listenPort, keepalive, peers: [{publicKey, endpoint?, allowedIPs, persistentKeepalive?}]}
#   (transport wireguard, instead of trunk/vlan): the site leg is a WireGuard device, created in the root namespace
#   (its UDP socket follows the node's own routing) and moved into the namespace, with the gateway's site address.
#   The node's private key is generated here once (/etc/shc-fabric/<instance>.wgkey) and never leaves the node;
#   peers not listed are removed. down also deletes the key.
#   shc-fabric-apply <instance> post   (gateway, after FRR started: see post_start below)
set -euo pipefail
NSX=""
I=${1:?usage: shc-fabric-apply <instance> [up|down|post]}; ACT=${2:-up}
CONF=/etc/shc-fabric/$I.json
[ -r "$CONF" ] || { echo "no $CONF" >&2; exit 2; }
q() { jq -er "$1" "$CONF"; }
TYPE=$(q .type)

# addresses on <dev> inside <cidr> other than <keep> (NSX: optional "ip netns exec <ns>" prefix)
stray() { $NSX ip -j -4 addr show dev "$1" | python3 -c '
import ipaddress, json, sys
net, keep = ipaddress.ip_network(sys.argv[1]), sys.argv[2]
for i in json.load(sys.stdin):
    for a in i.get("addr_info", []):
        s = "%s/%s" % (a["local"], a["prefixlen"])
        if ipaddress.ip_address(a["local"]) in net and s != keep:
            print(s)' "$2" "$3"; }

snapshot() {
  { ip -br -4 addr show dev lo; ip -br -4 addr show dev "$BR" 2>/dev/null || true
    ip -o link show "$BR" 2>/dev/null | grep -o 'mtu [0-9]*\|state [A-Z]*' || true
    cat "/sys/class/net/$BR/address" 2>/dev/null || true
    sysctl -n net.mpls.platform_labels 2>/dev/null || true
    sysctl -n "net.mpls.conf.$BR.input" net.mpls.conf.lo.input 2>/dev/null || true
    egress_state; attach_state; } | sha1sum
}

# an interface another service creates (NetworkManager's trunk and its VLAN devices): at boot this runs alongside
# NetworkManager (both before network.target), so wait for it a while. With a minimum MTU, also wait until it has at
# least that MTU: NetworkManager creates a VLAN device with the default MTU and raises it only on activation, and a
# macvlan or VLAN device on it can't be set above its MTU (EINVAL; seen at a blade reboot, egress0 at 9000 on 1500)
wait_link() {
  local i m
  for i in $(seq 1 90); do
    m=$(ip -j link show "$1" 2>/dev/null | jq -r '.[0].mtu // 0' 2>/dev/null) || m=0
    [ "${m:-0}" -gt 0 ] && [ "$m" -ge "${2:-0}" ] && return 0
    sleep 1
  done
  return 1
}

# provider internet egress (root): devices, addresses, proxy ARP entries and the nftables table (no counters)
egress_state() {
  ip -o link show 2>/dev/null | grep -E '^[0-9]+: (egress0|e[0-9]+|x[eo][0-9]+)[@:]' | grep -o '^[0-9]*: [^:]*\|mtu [0-9]*\|master [a-z0-9-]*\|state [A-Z]*' || true
  ip -br -4 addr show 2>/dev/null | grep -E '^(egress0|x[eo][0-9]+)[@ ]' || true
  ip -4 neigh show proxy dev egress0 2>/dev/null || true
  nft -s list table ip shc_egress 2>/dev/null || true
}

# the root VRFs e<digits> (networks' VRFs: egress and attachment circuits)
root_vrfs() { ip -j link show type vrf | jq -r '.[].ifname' | grep -E '^e[0-9]+$' || true; }

root_vrf() {  # <vrf> <table>
  ip link show "$1" >/dev/null 2>&1 || ip link add "$1" type vrf table "$2"
  ip link set "$1" up
}

# the root VRFs no network wants any more go with their veth and circuit devices (wanted: one VRF per line)
root_vrfs_prune() {
  local want="$1" v d
  for v in $(root_vrfs); do
    echo "$want" | grep -qx "$v" && continue
    ip link del "xe${v#e}" 2>/dev/null || true
    for d in $(ip -j link show master "$v" type vlan | jq -r '.[].ifname'); do ip link del "$d"; done
    ip link del "$v"
  done
}

egress_down() {
  local m x
  nft delete table ip shc_egress 2>/dev/null || true
  for x in $(ip -j link show type veth | jq -r '.[].ifname' | grep -E '^xe[0-9]+$' || true); do ip link del "$x"; done
  m=$(ip -j link show egress0 2>/dev/null | jq -r '.[0].master // empty')
  ip link del egress0 2>/dev/null || true
  if [ -n "$m" ] && ip -d link show "$m" 2>/dev/null | grep -q ' vrf table '; then ip link del "$m"; fi
}

# the nftables table for the listed networks (replaced as a whole)
egress_nft() {
  python3 - "$CONF" <<'PY'
import json, sys
e = json.load(open(sys.argv[1]))["egress"]
nets = e.get("networks") or []
def elements(xs):
    return ", ".join(xs)
out = ["table ip shc_egress", "delete table ip shc_egress", "table ip shc_egress {"]
if e.get("deny"):
    out.append(f"  set deny {{ type ipv4_addr; flags interval; elements = {{ {elements(e['deny'])} }}; }}")
if e.get("allow"):
    out.append(f"  set allow {{ type ipv4_addr; flags interval; elements = {{ {elements(e['allow'])} }}; }}")
zones = elements(f'"{n["xe"]}" : {n["zone"]}' for n in nets)
nats = elements(f'"{n["xe"]}" : {n["nat"]}' for n in nets if n.get("nat"))
srcs = e.get("platformSources") or []
ports = ", ".join(str(p) for p in e.get("platformPorts") or [6443, 443])
reach = [n for n in nets if n.get("platform") and srcs]
# a network's traffic reaches the veth through the VRF's output path; the rules go on output and forward alike
for hook in ("output", "prerouting"):
    out.append(f"  chain zone_{hook} {{")
    out.append(f"    type filter hook {hook} priority raw; policy accept;")
    if nets:
        out.append(f"    ct zone set {'oifname' if hook == 'output' else 'iifname'} map {{ {zones} }}")
    out.append("  }")
for hook in ("output", "forward"):
    out.append(f"  chain filter_{hook} {{")
    out.append(f"    type filter hook {hook} priority filter; policy accept;")
    for n in reach:  # replies to the platform (stateless: they may return through the other node)
        out.append(f'    oifname "{n["xe"]}" ip saddr {{ {elements(n["platform"])} }} ip daddr {{ {elements(srcs)} }} '
                   f'tcp sport {{ {ports} }} accept')
    if e.get("allow"):
        out.append('    oifname "xe*" ip daddr @allow accept')
    if e.get("deny"):
        out.append('    oifname "xe*" ip daddr @deny counter drop comment "destination not reachable through egress"')
    out.append("  }")
out.append("  chain inbound {")
out.append("    type filter hook prerouting priority filter; policy accept;")
for n in reach:  # the platform reaches the network's platform prefixes on its ports
    out.append(f'    iifname "{n["xe"]}" ip saddr {{ {elements(srcs)} }} ip daddr {{ {elements(n["platform"])} }} '
               f'tcp dport {{ {ports} }} accept')
out.append('    iifname "xe*" ct state new counter drop comment "nothing unsolicited into a network"')
out.append("  }")
out.append("  chain source_nat {")
out.append("    type nat hook postrouting priority srcnat; policy accept;")
if srcs:
    out.append(f'    oifname "xe*" ip daddr {{ {elements(srcs)} }} accept')
if nats:
    out.append(f"    snat ip to oifname map {{ {nats} }}")
out.append("  }")
out.append("}")
print("\n".join(out))
PY
}

egress_up() {
  local ev et par emtu eaddr want nat n v t z xe xo xea xoa a
  ev=$(q .egress.vrf); et=$(q .egress.table); par=$(q .egress.parent); emtu=$(q .egress.mtu); eaddr=$(q .egress.address)
  wait_link "$par" "$emtu" || { echo "egress parent interface $par missing or below MTU $emtu" >&2; exit 3; }
  modprobe vrf
  ip link show "$ev" >/dev/null 2>&1 || ip link add "$ev" type vrf table "$et"
  ip link set "$ev" up
  ip link show egress0 >/dev/null 2>&1 || ip link add egress0 link "$par" type macvlan mode bridge
  ip link set egress0 master "$ev" mtu "$emtu" up
  for a in $(stray egress0 0.0.0.0/0 "$eaddr"); do ip addr del "$a" dev egress0; done
  ip addr show dev egress0 | grep -q " ${eaddr} " || ip addr add "$eaddr" dev egress0
  sysctl -qw net.ipv4.neigh.egress0.proxy_delay=0
  want=$(jq -r '.egress.networks // [] | .[].vrf' "$CONF")
  for n in $(jq -r '.egress.networks // [] | .[] | [.vrf, .table, .xe, .xo, .xeAddr, .xoAddr] | join(":")' "$CONF"); do
    IFS=: read -r v t xe xo xea xoa <<<"$n"
    root_vrf "$v" "$t"
    ip link show "$xe" >/dev/null 2>&1 || ip link add "$xe" mtu "$emtu" type veth peer name "$xo" mtu "$emtu"
    ip link set "$xe" master "$v" mtu "$emtu" up
    ip link set "$xo" master "$ev" mtu "$emtu" up
    for a in $(stray "$xe" 0.0.0.0/0 "$xea"); do ip addr del "$a" dev "$xe"; done
    ip addr show dev "$xe" | grep -q " ${xea} " || ip addr add "$xea" dev "$xe"
    for a in $(stray "$xo" 0.0.0.0/0 "$xoa"); do ip addr del "$a" dev "$xo"; done
    ip addr show dev "$xo" | grep -q " ${xoa} " || ip addr add "$xoa" dev "$xo"
  done
  for v in $(ip -j link show type veth | jq -r '.[].ifname' | grep -E '^xe[0-9]+$' || true); do
    echo "$want" | grep -qx "e${v#xe}" || ip link del "$v"
  done
  nat=$(jq -r '.egress.networks // [] | .[].nat | select(. != null and . != "")' "$CONF")
  for a in $(ip -4 neigh show proxy dev egress0 | awk '{print $1}'); do
    echo "$nat" | grep -qx "$a" || ip neigh del proxy "$a" dev egress0
  done
  for a in $nat; do ip -4 neigh show proxy dev egress0 | grep -q "^$a " || ip neigh add proxy "$a" dev egress0; done
  egress_nft | nft -f -
}

# attachment circuits (root): the circuit devices present - VLAN devices in a root VRF, or on a listed parent with
# a VLAN in the pool
attach_devices() {
  ip -j -d link show type vlan | python3 -c '
import json, re, sys
parents, lo, hi = [p for p in sys.argv[1].split(",") if p], int(sys.argv[2]), int(sys.argv[3])
for l in json.load(sys.stdin):
    vid = ((l.get("linkinfo") or {}).get("info_data") or {}).get("id")
    if re.fullmatch(r"e[0-9]+", l.get("master") or "") or (l.get("link") in parents and vid is not None and lo <= vid <= hi):
        print(l["ifname"])' "$(jq -r '(.attachments.parents // []) | join(",")' "$CONF")" \
    "$(jq -r '.attachments.vlanPool[0] // 1' "$CONF")" "$(jq -r '.attachments.vlanPool[1] // 0' "$CONF")"
}

# devices, addresses, filters and the nftables table (no counters)
attach_state() {
  local d
  for d in $(attach_devices); do
    ip -o link show dev "$d" | grep -o '^[0-9]*: [^:]*\|mtu [0-9]*\|master [a-z0-9-]*\|state [A-Z]*'
    ip -br -4 addr show dev "$d"
    cat "/proc/sys/net/ipv4/conf/$d/rp_filter" "/proc/sys/net/ipv6/conf/$d/disable_ipv6" 2>/dev/null || true
  done
  nft -s list table ip shc_attach 2>/dev/null || true
}

attach_down() {
  local d
  nft delete table ip shc_attach 2>/dev/null || true
  for d in $(attach_devices); do ip link del "$d"; done
}

# the nftables table for the listed circuits (replaced as a whole)
attach_nft() {
  python3 - "$CONF" <<'PY'
import json, sys
a = json.load(open(sys.argv[1]))["attachments"]
cs = a.get("circuits") or []
srcs = a.get("platformSources") or []
def devs(xs):
    return "{ " + ", ".join(f'"{c["device"]}"' for c in xs) + " }"
out = ["table ip shc_attach", "delete table ip shc_attach", "table ip shc_attach {"]
if cs:
    zones = ", ".join(f'"{c["device"]}" : {c["zone"]}' for c in cs)
    # the node's own packets in a VRF (BGP, BFD, ICMP to the CE) pass output first with the VRF as their output
    # interface, and are tracked then: the VRF's zone too, so the CE's replies find them
    vrfs = {c["vrf"]: c["zone"] for c in cs}
    zones_out = zones + "".join(f', "{v}" : {z}' for v, z in sorted(vrfs.items()))
    # the network's zone: a circuit's traffic that leaves through the network's egress veth is source-NATed there
    out += ["  chain zone_prerouting {", "    type filter hook prerouting priority raw; policy accept;",
            f"    ct zone set iifname map {{ {zones} }}", "  }",
            "  chain zone_output {", "    type filter hook output priority raw; policy accept;",
            f"    ct zone set oifname map {{ {zones_out} }}", "  }"]
    # past prerouting, a packet from a device in a VRF shows the VRF as its input interface: the circuit's device is
    # the slave interface (meta sdifname)
    out += ["  chain input {", "    type filter hook input priority filter; policy accept;"]
    # BGP from the CE's link either way, whatever conntrack knows: a network's zone moves when its egress is turned
    # on or off, and the CE's packets of a session the node opened would then look new
    for c in cs:
        out.append(f'    meta sdifname "{c["device"]}" ip saddr {c["link"]} tcp dport 179 accept')
        out.append(f'    meta sdifname "{c["device"]}" ip saddr {c["link"]} tcp sport 179 accept')
    out += [f"    meta sdifname {devs(cs)} ct state established,related accept",
            f"    meta sdifname {devs(cs)} udp dport {{ 3784, 3785 }} accept",
            f"    meta sdifname {devs(cs)} icmp type {{ echo-request, echo-reply, destination-unreachable, time-exceeded }} accept",
            f'    meta sdifname {devs(cs)} counter drop comment "only BGP, BFD and ICMP from a circuit to the node"', "  }"]
    out += ["  chain forward {", "    type filter hook forward priority filter; policy accept;"]
    if srcs:
        out.append(f'    meta sdifname {devs(cs)} ip daddr {{ {", ".join(srcs)} }} counter drop comment "the platform\'s sources"')
    closed = [c for c in cs if not c.get("nat")]
    if closed:
        out.append(f'    meta sdifname {devs(closed)} oifname "xe*" counter drop comment "no provider egress for this circuit"')
    out.append("  }")
out.append("}")
print("\n".join(out))
PY
}

attach_up() {
  local c dev par vlan mtu v t addr a want
  modprobe vrf; modprobe 8021q
  want=$(jq -r '.attachments.circuits // [] | .[].device' "$CONF")
  for c in $(jq -r '.attachments.circuits // [] | .[] | [.device, .parent, .vlan, .mtu, .vrf, .table, .address] | join(":")' "$CONF"); do
    IFS=: read -r dev par vlan mtu v t addr <<<"$c"
    wait_link "$par" "$mtu" || { echo "bearer interface $par missing or below MTU $mtu" >&2; exit 3; }
    root_vrf "$v" "$t"
    ip link show "$dev" >/dev/null 2>&1 || ip link add link "$par" name "$dev" type vlan id "$vlan"
    # sysctl names with "/": the device name holds a dot
    sysctl -qw "net/ipv6/conf/$dev/disable_ipv6=1" "net/ipv4/conf/$dev/rp_filter=1"
    [ "$(ip -j link show dev "$dev" | jq -r '.[0].master // empty')" = "$v" ] || ip link set "$dev" master "$v"
    ip link set "$dev" mtu "$mtu" up
    for a in $(stray "$dev" 0.0.0.0/0 "$addr"); do ip addr del "$a" dev "$dev"; done
    ip addr show dev "$dev" | grep -q " ${addr} " || ip addr add "$addr" dev "$dev"
  done
  for dev in $(attach_devices); do echo "$want" | grep -qx "$dev" || ip link del "$dev"; done
  if [ -n "$want" ]; then attach_nft | nft -f -; else nft delete table ip shc_attach 2>/dev/null || true; fi
}

# After the gateway's FRR starts with VRFs in its configuration, zebra's VRF setup can recreate bgpd's listen
# socket after the site peer group's TCP MD5 password was applied to it; the site's sessions then never come up
# (TcpExtTCPMD5Unexpected grows). Once the VRFs are known to FRR, set the password again (read from frr.conf, never
# printed). Harmless when nothing was lost: there are no site sessions yet right after a start.
post_start() {
  local ns conf asn pw i want have
  ns=$(q .netns); conf=/etc/frr/$ns/frr.conf.shc; [ -f "$conf" ] || conf=/etc/frr/$ns/frr.conf
  want=$(jq -r '.vrfs // [] | .[].name' "$CONF" | sort | tr '\n' ' ')
  for i in $(seq 1 30); do
    have=$(vtysh -N "$ns" -c 'show vrf' 2>/dev/null | awk '$1 == "vrf" {print $2}' | sort | tr '\n' ' ')
    vtysh -N "$ns" -c 'show bgp summary' >/dev/null 2>&1 && [ "$have" = "$want" ] && break
    sleep 2
  done
  sleep 3
  asn=$(awk '/^router bgp [0-9]+$/ {print $3; exit}' "$conf")
  pw=$(awk '/^ neighbor SITE password / {print $4; exit}' "$conf")
  if [ -n "$asn" ] && [ -n "$pw" ]; then
    vtysh -N "$ns" -c 'configure terminal' -c "router bgp $asn" -c 'no neighbor SITE password' \
      -c "neighbor SITE password $pw" >/dev/null 2>&1 || echo "site password refresh failed" >&2
    echo "site password refreshed (VRFs: ${want:-none})"
  fi
  unset pw
}

case "$TYPE" in
root)
  BR=$(q .bridge); MTU=$(q .mtu); LO=$(q .loopback); LOPOOL=$(q .loopbackPool); LINK=$(q .link)
  before=$(snapshot)
  if [ "$ACT" = up ]; then
    modprobe mpls_router; modprobe mpls_iptunnel
    sysctl -qw net.mpls.platform_labels=1048575
    MAC=$(printf '02:fa:%02x:%02x:%02x:%02x' $(echo "${LINK%/*}" | tr . ' '))
    ip link show "$BR" >/dev/null 2>&1 || ip link add "$BR" address "$MAC" type bridge
    if [ "$(cat "/sys/class/net/$BR/address")" != "$MAC" ]; then ip link set "$BR" address "$MAC"; echo "bridge-mac=changed"; fi
    ip link set "$BR" mtu "$MTU" up
    for a in $(stray "$BR" 0.0.0.0/0 "$LINK"); do ip addr del "$a" dev "$BR"; done
    ip addr show dev "$BR" | grep -q " ${LINK} " || ip addr add "$LINK" dev "$BR"
    for a in $(stray lo "$LOPOOL" "$LO"); do ip addr del "$a" dev lo; done
    ip addr show dev lo | grep -q " ${LO} " || ip addr add "$LO" dev lo
    sysctl -qw "net.mpls.conf.$BR.input=1" net.mpls.conf.lo.input=1
    if jq -e '.egress.vrf' "$CONF" >/dev/null 2>&1; then egress_up; else egress_down; fi
    if jq -e '.attachments' "$CONF" >/dev/null 2>&1; then attach_up; else attach_down; fi
    root_vrfs_prune "$(jq -r '[(.egress.networks // [])[].vrf, (.attachments.circuits // [])[].vrf] | unique | .[]' "$CONF")"
  else
    egress_down
    attach_down
    root_vrfs_prune ""
    ip link show "$BR" >/dev/null 2>&1 && ip link del "$BR"
    for a in $(stray lo "$LOPOOL" none); do ip addr del "$a" dev lo; done
  fi
  ;;
gateway)
  if [ "$ACT" = post ]; then post_start; exit 0; fi
  NS=$(q .netns); ADDR=$(q .address)
  if jq -e '.wireguard' "$CONF" >/dev/null 2>&1; then
    WG=1; VDEV=$(q .wireguard.device); WGKEY=/etc/shc-fabric/$I.wgkey
  else
    WG=""; TRUNK=$(q .trunk); VLAN=$(q .vlan); VDEV="$TRUNK.$VLAN"
  fi
  LO=$(q .loopback); LOPOOL=$(q .loopbackPool); BR=$(q .coreBridge); CV=$(q .coreVeth); LINK=$(q .link)
  CMTU=$(q .coreMtu); MTU=$(jq -r '.mtu // empty' "$CONF"); X="ip netns exec $NS"
  snapshot() {
    { ip netns list | grep -w "^$NS" || true; ip -o link show "$CV" 2>/dev/null | grep -o 'mtu [0-9]*\|master [a-z0-9-]*\|state [A-Z]*' || true
      if ip netns list | grep -qw "^$NS"; then
        $X ip -br -4 addr show; $X ip -o link show | grep -o '^[0-9]*: [^:]*\|mtu [0-9]*\|state [A-Z]*' || true
        $X sysctl -n net.ipv4.ip_forward net.mpls.platform_labels net.mpls.conf.lo.input 2>/dev/null || true
        $X sysctl -n net.mpls.conf.core0.input 2>/dev/null || true
        if [ -n "$WG" ] && $X ip link show "$VDEV" >/dev/null 2>&1; then
          $X wg show "$VDEV" public-key; $X wg show "$VDEV" listen-port
          $X wg show "$VDEV" allowed-ips | sort; $X wg show "$VDEV" persistent-keepalive | sort
        fi
      fi; } | sha1sum
  }
  # the site leg over WireGuard (transport wireguard)
  wg_leg() {
    local port keep want peer p ep
    port=$(jq -r '.wireguard.listenPort // 51820' "$CONF"); keep=$(jq -r '.wireguard.keepalive // 25' "$CONF")
    [ -s "$WGKEY" ] || (umask 077; wg genkey > "$WGKEY")
    if ! $X ip link show "$VDEV" >/dev/null 2>&1; then
      ip link show "$VDEV" >/dev/null 2>&1 || ip link add "$VDEV" type wireguard
      ip link set "$VDEV" netns "$NS"
    fi
    $X wg set "$VDEV" private-key "$WGKEY" listen-port "$port"
    want=$(jq -r '.wireguard.peers[].publicKey' "$CONF")
    for peer in $($X wg show "$VDEV" peers); do
      echo "$want" | grep -qxF -- "$peer" || $X wg set "$VDEV" peer "$peer" remove
    done
    while read -r p; do
      set -- peer "$(jq -r .publicKey <<<"$p")" allowed-ips "$(jq -r '.allowedIPs | join(",")' <<<"$p")" \
        persistent-keepalive "$(jq -r --arg k "$keep" '.persistentKeepalive // ($k | tonumber)' <<<"$p")"
      ep=$(jq -r '.endpoint // empty' <<<"$p"); [ -z "$ep" ] || set -- "$@" endpoint "$ep"
      $X wg set "$VDEV" "$@"
    done < <(jq -c '.wireguard.peers[]' "$CONF")
    [ -n "$MTU" ] || MTU=1420
    $X ip link set "$VDEV" mtu "$MTU" up
  }
  before=$(snapshot)
  if [ "$ACT" = up ]; then
    ip link show "$BR" >/dev/null 2>&1 || { echo "core bridge $BR missing: the root instance must be up first" >&2; exit 3; }
    ip netns list | grep -qw "^$NS" || ip netns add "$NS"
    $X sysctl -qw net.ipv4.ip_forward=1 net.ipv4.conf.all.rp_filter=0 net.ipv4.conf.default.rp_filter=0 \
      net.mpls.platform_labels=1048575
    $X ip link set lo up
    NSX=$X
    for a in $(stray lo "$LOPOOL" "$LO"); do $X ip addr del "$a" dev lo; done
    $X ip addr show dev lo | grep -q " ${LO} " || $X ip addr add "$LO" dev lo
    if [ -n "$WG" ]; then
      wg_leg
    else
      if ! $X ip link show "$VDEV" >/dev/null 2>&1; then
        ip link show "$VDEV" >/dev/null 2>&1 || ip link add link "$TRUNK" name "$VDEV" type vlan id "$VLAN"
        ip link set "$VDEV" netns "$NS"
      fi
      [ -n "$MTU" ] || MTU=$(cat "/sys/class/net/$TRUNK/mtu")
      $X ip link set "$VDEV" mtu "$MTU" up
    fi
    for a in $(stray "$VDEV" 0.0.0.0/0 "$ADDR"); do $X ip addr del "$a" dev "$VDEV"; done
    $X ip addr show dev "$VDEV" | grep -q " ${ADDR} " || $X ip addr add "$ADDR" dev "$VDEV"
    if ! ip link show "$CV" >/dev/null 2>&1; then
      $X ip link del core0 >/dev/null 2>&1 || true
      ip link add "$CV" mtu "$CMTU" type veth peer name core0 netns "$NS"
    fi
    ip link set "$CV" master "$BR" mtu "$CMTU" up
    $X ip link set core0 mtu "$CMTU" up
    for a in $(stray core0 0.0.0.0/0 "$LINK"); do $X ip addr del "$a" dev core0; done
    $X ip addr show dev core0 | grep -q " ${LINK} " || $X ip addr add "$LINK" dev core0
    $X sysctl -qw net.mpls.conf.lo.input=1 net.mpls.conf.core0.input=1
    VTEP=${ADDR%/*}
    WANT=$(jq -r '.vrfs // [] | .[].name' "$CONF")
    [ -z "$WANT" ] || modprobe vrf
    for v in $(jq -r '.vrfs // [] | .[] | [.name, .vni, (.mtu // 9000)] | join(":")' "$CONF"); do
      IFS=: read -r VRF VNI VMTU <<<"$v"
      $X ip link show "$VRF" >/dev/null 2>&1 || $X ip link add "$VRF" type vrf table "$VNI"
      $X ip link set "$VRF" up
      if ! $X ip link show "br$VNI" >/dev/null 2>&1; then
        $X ip link add "br$VNI" type bridge
        $X ip link set "br$VNI" addrgenmode none
      fi
      $X ip link set "br$VNI" master "$VRF" mtu "$VMTU" up
      if ! $X ip link show "vx$VNI" >/dev/null 2>&1; then
        $X ip link add "vx$VNI" type vxlan id "$VNI" dstport 4789 local "$VTEP" nolearning
        $X ip link set "vx$VNI" addrgenmode none
      fi
      $X ip link set "vx$VNI" master "br$VNI" mtu "$VMTU" up
      $X ip link set "vx$VNI" type bridge_slave neigh_suppress on learning off
      $X sysctl -qw "net.mpls.conf.$VRF.input=1" 2>/dev/null || true
    done
    # TCP towards a site never uses segments larger than its leg carries (rt mtu = the route's device MTU): the
    # VRFs hold no address to send "fragmentation needed" from, so path MTU discovery alone would black-hole.
    # Forwarded SYNs (from the site's leg) pass the forward hook on the bridge port; SYNs that arrive over the core
    # (MPLS popped into the VRF, e.g. another site's gateway) leave through the output hook on the VRF's bridge.
    if [ -n "$WANT" ]; then
      printf '%s\n' 'add table inet shc_gw_mss' 'delete table inet shc_gw_mss' 'table inet shc_gw_mss {' \
        '  chain clamp {' '    type filter hook forward priority mangle; policy accept;' \
        '    oifname "vx*" tcp flags syn tcp option maxseg size set rt mtu' '  }' \
        '  chain clamp_core {' '    type filter hook output priority mangle; policy accept;' \
        '    oifname "br*" tcp flags syn tcp option maxseg size set rt mtu' '  }' '}' | $X nft -f -
    else
      $X nft delete table inet shc_gw_mss 2>/dev/null || true
    fi
    for VRF in $($X ip -j link show type vrf | jq -r '.[].ifname' | grep -E '^t[0-9]+$' || true); do
      echo "$WANT" | grep -qx "$VRF" && continue
      VNI=${VRF#t}
      $X ip link del "vx$VNI" 2>/dev/null || true
      $X ip link del "br$VNI" 2>/dev/null || true
      $X ip link del "$VRF"
    done
    NSX=""
  else
    ip link show "$CV" >/dev/null 2>&1 && ip link del "$CV"
    ip netns list | grep -qw "^$NS" && ip netns del "$NS"
    [ -z "$WG" ] || rm -f "$WGKEY"
  fi
  ;;
*) echo "unknown instance type $TYPE" >&2; exit 2 ;;
esac
[ "$before" = "$(snapshot)" ] && echo "changed=no" || echo "changed=yes"
