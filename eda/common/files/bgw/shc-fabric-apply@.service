# shc: fabric instance on a border gateway node (installed by the platform's fabric jobs). The root instance has
# no network dependency (a bridge and loopback addresses) and runs before FRR.
[Unit]
Description=shc fabric instance %i
DefaultDependencies=no
After=systemd-modules-load.service systemd-sysctl.service network-pre.target
Wants=network-pre.target
Before=frr.service network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/shc-fabric-apply %i up
# a oneshot start has no time limit by default: bound it (its waits for interfaces take up to 90 s each), so a start
# the platform's jobs begin ends within the time their lease allows for a systemd job (nodes.configLease)
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
