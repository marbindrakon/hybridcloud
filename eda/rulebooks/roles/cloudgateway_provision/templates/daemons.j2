# Managed by the platform: CloudGateway {{ fab_name }}. FRR daemons of the gateway instance (network namespace
# gw-{{ fab_name }}); zebra and staticd always run.
bgpd=yes
isisd=yes
bfdd=yes
vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
bgpd_options="   -A 127.0.0.1"
isisd_options="  -A 127.0.0.1"
bfdd_options="   -A 127.0.0.1"
watchfrr_options="--netns=gw-{{ fab_name }}"
