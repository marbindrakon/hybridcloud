! Managed by the platform: HybridFabric {{ fab_name }}, border gateway root instance. Changes here are overwritten.
frr version 8.5
frr defaults traditional
hostname {{ bgw_node.name }}
log syslog informational
service integrated-vtysh-config
!
! mpls enable mirrors the kernel's MPLS input (set by shc-fabric-apply): zebra shows it in the running config, so
! without it here a configuration reload would turn MPLS input off.
! The root is always the core LAN's designated IS (priority 127): a gateway that joined and won the election (equal
! priority, higher MAC) left FRR 8.5's LSPs on every node without the LAN's pseudonode, so no core routes, until the
! root restarted.
interface {{ hf_root.bridge }}
 ip router isis CORE
 isis priority 127
 mpls enable
exit
!
interface lo
 ip router isis CORE
 isis passive
 mpls enable
exit
!
! no graceful restart: when a gateway (a listen-range peer) is removed, FRR 8.5's restart timer for it still fired
! two minutes later on the deleted peer and bgpd aborted (every VPNv4 session down until watchfrr restarted it)
router bgp {{ fab_spec.domainAsn }}
 bgp router-id {{ hf_pe.loopbackIp }}
 bgp cluster-id {{ hf_pe.loopbackIp }}
 no bgp default ipv4-unicast
 bgp graceful-restart-disable
 neighbor PE peer-group
 neighbor PE remote-as {{ fab_spec.domainAsn }}
 neighbor PE update-source lo
 bgp listen range {{ fab_real.core.loopbackPool }} peer-group PE
 !
 address-family ipv4 vpn
  neighbor PE activate
  neighbor PE route-reflector-client
 exit-address-family
exit
!
{% if hf_node_egress.networks is defined %}
! provider internet egress: the hand-off's default route, and each network's NAT address back to its VRF;
! platform reach: each network's platform prefixes towards its VRF, and the platform's sources back to the hand-off
vrf {{ hf_node_egress.vrf }}
 ip route 0.0.0.0/0 {{ hf_node_egress.gateway }}
{% for n in hf_node_egress.networks %}
{% if n.nat | default('') %}
 ip route {{ n.nat }}/32 {{ n.xeIp }}
{% endif %}
{% for c in n.platform | default([]) %}
 ip route {{ c }} {{ n.xeIp }}
{% endfor %}
{% endfor %}
exit-vrf
!
{% for n in hf_node_egress.networks %}
vrf {{ n.vrf }}
{% if n.internet | default(true) %}
 ip route 0.0.0.0/0 {{ n.xoIp }}
{% endif %}
{% if n.platform | default([]) %}
{% for c in hf_node_egress.platformSources | default([]) %}
 ip route {{ c }} {{ n.xoIp }}
{% endfor %}
{% endif %}
exit-vrf
!
{% endfor %}
ip prefix-list SHC-EGRESS-DEFAULT seq 5 permit 0.0.0.0/0
{% for c in hf_node_egress.platformSources | default([]) %}
ip prefix-list SHC-EGRESS-DEFAULT seq {{ 10 + loop.index0 * 5 }} permit {{ c }}
{% endfor %}
!
route-map SHC-EGRESS-DEFAULT permit 10
 match ip address prefix-list SHC-EGRESS-DEFAULT
exit
!
{% endif %}
{% for v in hf_node_vrfs %}
{% for c in v.circuits %}
! AttachmentCircuit {{ c.circuit }} (VLAN {{ c.vlan }}, CE {{ c.ce }} AS {{ c.peerAsn }}): routes from the CE in the
! accept list and outside the deny list; to the CE the network's placement prefixes{{ ' and the default route' if c.advertiseDefault else '' }}
{% for e in c.accept %}
ip prefix-list {{ c.id }}-ACCEPT seq {{ loop.index * 5 }} permit {{ e }}
{% endfor %}
{% for e in c.deny %}
ip prefix-list {{ c.id }}-DENY seq {{ loop.index * 5 }} permit {{ e }}
{% endfor %}
{% for e in c.advertise %}
ip prefix-list {{ c.id }}-OUT seq {{ loop.index * 5 }} permit {{ e }}
{% endfor %}
!
route-map {{ c.id }}-IN deny 10
 match ip address prefix-list {{ c.id }}-DENY
exit
!
route-map {{ c.id }}-IN permit 20
 match ip address prefix-list {{ c.id }}-ACCEPT
exit
!
{% if c.advertise %}
route-map {{ c.id }}-OUT permit 10
 match ip address prefix-list {{ c.id }}-OUT
exit
{% else %}
route-map {{ c.id }}-OUT deny 10
exit
{% endif %}
!
{% endfor %}
{% endfor %}
{% for n in hf_node_vrfs %}
! HybridNetwork {{ n.network }}: {{ ('internet egress (source NAT ' ~ n.nat ~ ' on this node)') if n.nat | default('') else '' }}{{ ' platform reach ' ~ n.platform | default([]) | join(',') if n.platform | default([]) else '' }}{{ ((' ' if n.egress else '') ~ 'attachment circuits ' ~ n.circuits | map(attribute='id') | join(',')) if n.circuits else '' }} (VPN {{ fab_spec.domainAsn }}:{{ n.vpnTarget }})
router bgp {{ fab_spec.domainAsn }} vrf {{ n.vrf }}
 bgp router-id {{ hf_pe.loopbackIp }}
 no bgp default ipv4-unicast
{% for c in n.circuits %}
 neighbor {{ c.ce }} remote-as {{ c.peerAsn }}
 neighbor {{ c.ce }} description {{ c.id }} {{ c.circuit }}
{% if c.authentication == 'md5' %}
 neighbor {{ c.ce }} password {{ hf_circuit_passwords[c.circuit] }}
{% endif %}
 neighbor {{ c.ce }} timers 10 30
{% if c.bfd %}
 neighbor {{ c.ce }} bfd
{% endif %}
{% endfor %}
 !
 address-family ipv4 unicast
{% if n.egress %}
  redistribute static route-map SHC-EGRESS-DEFAULT
{% endif %}
{# no soft-reconfiguration inbound: the routes the policy rejects would be kept, and maximum-prefix doesn't bound
   them (a CE could fill the node's memory); a policy change asks the CE to send its routes again (route refresh) #}
{% for c in n.circuits %}
  neighbor {{ c.ce }} activate
  neighbor {{ c.ce }} route-map {{ c.id }}-IN in
  neighbor {{ c.ce }} route-map {{ c.id }}-OUT out
  neighbor {{ c.ce }} maximum-prefix {{ c.maxPrefixes }}{{ ' warning-only' if c.maxPrefixAction == 'warning' else (' restart ' ~ hf_attach_restart if hf_attach_restart | int > 0 else '') }}
{% endfor %}
  label vpn export auto
  rd vpn export {{ n.rd or (hf_pe.loopbackIp ~ ':' ~ (n.vpnTarget | int % 65536)) }}
  rt vpn both {{ fab_spec.domainAsn }}:{{ n.vpnTarget }}
{# FRR tracks an exported BGP route's next hop inside the VRF, where the loopback is unknown: with a CE's routes
   in the VRF, the VPN routes keep their own next hop (announced as the node's own address) #}
{% if not n.circuits %}
  nexthop vpn export {{ hf_pe.loopbackIp }}
{% endif %}
  export vpn
  import vpn
 exit-address-family
exit
!
{% endfor %}
router isis CORE
 is-type level-2-only
 net {{ hf_pe.net }}
 segment-routing on
 segment-routing global-block {{ fab_real.core.srgb.start }} {{ fab_real.core.srgb.end }}
 segment-routing prefix {{ hf_pe.loopback }} index {{ hf_pe.index }}
exit
!
