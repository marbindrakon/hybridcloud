#!/bin/bash
# shc-fabric-apply: realize one fabric instance on a border gateway node from /etc/shc-fabric/<instance>.json.
# Installed and run by the platform's HybridFabric/CloudGateway jobs, and at boot by shc-fabric-apply@<instance>
# before FRR starts. Idempotent; the last line says whether anything changed ("changed=yes|no").
#   shc-fabric-apply <instance> [up|down]
# instance type "root" (the border gateway's own instance, root namespace):
#   MPLS (modules, platform_labels), the node-local core bridge with the link address and a fixed MAC (a Linux bridge
#   otherwise takes a port's MAC whenever ports change, and IS-IS on it keeps the old one: prints bridge-mac=changed
#   when it had to set it, so FRR can be restarted), the provider-edge loopback on lo; other addresses from the
#   fabric's core prefixes are removed.
# instance type "gateway" (a CloudGateway, network namespace <netns>):
#   the namespace (forwarding, MPLS), the provider-edge loopback, the site's underlay VLAN on the trunk moved into
#   the namespace with the gateway's site address, and a veth from the namespace's core0 (link address) to the core
#   bridge. down deletes the veth and the namespace (the VLAN device goes with it). FRR's routes are FRR's own
#   (staticd), never kernel routes set here.
set -euo pipefail
NSX=""
I=${1:?usage: shc-fabric-apply <instance> [up|down]}; ACT=${2:-up}
CONF=/etc/shc-fabric/$I.json
[ -r "$CONF" ] || { echo "no $CONF" >&2; exit 2; }
q() { jq -er "$1" "$CONF"; }
TYPE=$(q .type)

# addresses on <dev> inside <cidr> other than <keep> (NSX: optional "ip netns exec <ns>" prefix)
stray() { $NSX ip -j -4 addr show dev "$1" | python3 -c '
import ipaddress, json, sys
net, keep = ipaddress.ip_network(sys.argv[1]), sys.argv[2]
for i in json.load(sys.stdin):
    for a in i.get("addr_info", []):
        s = "%s/%s" % (a["local"], a["prefixlen"])
        if ipaddress.ip_address(a["local"]) in net and s != keep:
            print(s)' "$2" "$3"; }

snapshot() {
  { ip -br -4 addr show dev lo; ip -br -4 addr show dev "$BR" 2>/dev/null || true
    ip -o link show "$BR" 2>/dev/null | grep -o 'mtu [0-9]*\|state [A-Z]*' || true
    cat "/sys/class/net/$BR/address" 2>/dev/null || true
    sysctl -n net.mpls.platform_labels 2>/dev/null || true
    sysctl -n "net.mpls.conf.$BR.input" net.mpls.conf.lo.input 2>/dev/null || true; } | sha1sum
}

case "$TYPE" in
root)
  BR=$(q .bridge); MTU=$(q .mtu); LO=$(q .loopback); LOPOOL=$(q .loopbackPool); LINK=$(q .link)
  before=$(snapshot)
  if [ "$ACT" = up ]; then
    modprobe mpls_router; modprobe mpls_iptunnel
    sysctl -qw net.mpls.platform_labels=1048575
    MAC=$(printf '02:fa:%02x:%02x:%02x:%02x' $(echo "${LINK%/*}" | tr . ' '))
    ip link show "$BR" >/dev/null 2>&1 || ip link add "$BR" address "$MAC" type bridge
    if [ "$(cat "/sys/class/net/$BR/address")" != "$MAC" ]; then ip link set "$BR" address "$MAC"; echo "bridge-mac=changed"; fi
    ip link set "$BR" mtu "$MTU" up
    for a in $(stray "$BR" 0.0.0.0/0 "$LINK"); do ip addr del "$a" dev "$BR"; done
    ip addr show dev "$BR" | grep -q " ${LINK} " || ip addr add "$LINK" dev "$BR"
    for a in $(stray lo "$LOPOOL" "$LO"); do ip addr del "$a" dev lo; done
    ip addr show dev lo | grep -q " ${LO} " || ip addr add "$LO" dev lo
    sysctl -qw "net.mpls.conf.$BR.input=1" net.mpls.conf.lo.input=1
  else
    ip link show "$BR" >/dev/null 2>&1 && ip link del "$BR"
    for a in $(stray lo "$LOPOOL" none); do ip addr del "$a" dev lo; done
  fi
  ;;
gateway)
  NS=$(q .netns); TRUNK=$(q .trunk); VLAN=$(q .vlan); VDEV="$TRUNK.$VLAN"; ADDR=$(q .address)
  LO=$(q .loopback); LOPOOL=$(q .loopbackPool); BR=$(q .coreBridge); CV=$(q .coreVeth); LINK=$(q .link)
  CMTU=$(q .coreMtu); MTU=$(jq -r '.mtu // empty' "$CONF"); X="ip netns exec $NS"
  snapshot() {
    { ip netns list | grep -w "^$NS" || true; ip -o link show "$CV" 2>/dev/null | grep -o 'mtu [0-9]*\|master [a-z0-9-]*\|state [A-Z]*' || true
      if ip netns list | grep -qw "^$NS"; then
        $X ip -br -4 addr show; $X ip -o link show | grep -o '^[0-9]*: [^:]*\|mtu [0-9]*\|state [A-Z]*' || true
        $X sysctl -n net.ipv4.ip_forward net.mpls.platform_labels net.mpls.conf.lo.input 2>/dev/null || true
        $X sysctl -n net.mpls.conf.core0.input 2>/dev/null || true
      fi; } | sha1sum
  }
  before=$(snapshot)
  if [ "$ACT" = up ]; then
    ip link show "$BR" >/dev/null 2>&1 || { echo "core bridge $BR missing: the root instance must be up first" >&2; exit 3; }
    ip netns list | grep -qw "^$NS" || ip netns add "$NS"
    $X sysctl -qw net.ipv4.ip_forward=1 net.ipv4.conf.all.rp_filter=0 net.ipv4.conf.default.rp_filter=0 \
      net.mpls.platform_labels=1048575
    $X ip link set lo up
    NSX=$X
    for a in $(stray lo "$LOPOOL" "$LO"); do $X ip addr del "$a" dev lo; done
    $X ip addr show dev lo | grep -q " ${LO} " || $X ip addr add "$LO" dev lo
    if ! $X ip link show "$VDEV" >/dev/null 2>&1; then
      ip link show "$VDEV" >/dev/null 2>&1 || ip link add link "$TRUNK" name "$VDEV" type vlan id "$VLAN"
      ip link set "$VDEV" netns "$NS"
    fi
    [ -n "$MTU" ] || MTU=$(cat "/sys/class/net/$TRUNK/mtu")
    $X ip link set "$VDEV" mtu "$MTU" up
    for a in $(stray "$VDEV" 0.0.0.0/0 "$ADDR"); do $X ip addr del "$a" dev "$VDEV"; done
    $X ip addr show dev "$VDEV" | grep -q " ${ADDR} " || $X ip addr add "$ADDR" dev "$VDEV"
    if ! ip link show "$CV" >/dev/null 2>&1; then
      $X ip link del core0 >/dev/null 2>&1 || true
      ip link add "$CV" mtu "$CMTU" type veth peer name core0 netns "$NS"
    fi
    ip link set "$CV" master "$BR" mtu "$CMTU" up
    $X ip link set core0 mtu "$CMTU" up
    for a in $(stray core0 0.0.0.0/0 "$LINK"); do $X ip addr del "$a" dev core0; done
    $X ip addr show dev core0 | grep -q " ${LINK} " || $X ip addr add "$LINK" dev core0
    $X sysctl -qw net.mpls.conf.lo.input=1 net.mpls.conf.core0.input=1
    NSX=""
  else
    ip link show "$CV" >/dev/null 2>&1 && ip link del "$CV"
    ip netns list | grep -qw "^$NS" && ip netns del "$NS"
  fi
  ;;
*) echo "unknown instance type $TYPE" >&2; exit 2 ;;
esac
[ "$before" = "$(snapshot)" ] && echo "changed=no" || echo "changed=yes"
