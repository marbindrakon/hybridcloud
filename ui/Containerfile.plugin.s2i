# Multi-stage console plugin build for OpenShift BuildConfig
ARG PLUGIN_PACKAGE=admin-console-plugin
FROM registry.access.redhat.com/ubi9/nodejs-20:latest AS build
ARG PLUGIN_PACKAGE
USER 0
WORKDIR /opt/app-root/src
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/admin-dashboard/package.json ./packages/admin-dashboard/package.json
COPY packages/tenant-dashboard/package.json ./packages/tenant-dashboard/package.json
COPY packages/admin-console-plugin/package.json ./packages/admin-console-plugin/package.json
COPY packages/tenant-console-plugin/package.json ./packages/tenant-console-plugin/package.json
RUN npm ci
COPY packages/shared ./packages/shared
COPY packages/${PLUGIN_PACKAGE} ./packages/${PLUGIN_PACKAGE}
COPY docker ./docker
RUN npm run build -w @hybridsovereign/shared && \
    npm run build -w @hybridsovereign/${PLUGIN_PACKAGE}

FROM nginx:1.27-alpine
ARG PLUGIN_PACKAGE
COPY docker/nginx-plugin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /opt/app-root/src/packages/${PLUGIN_PACKAGE}/dist/ /usr/share/nginx/html/
RUN mkdir -p /tmp && \
    chown -R 1001:0 /usr/share/nginx/html /var/cache/nginx /var/log/nginx /tmp && \
    chmod -R g+rwX /usr/share/nginx/html /var/cache/nginx /var/log/nginx /tmp && \
    sed -i 's|pid .*|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf && \
    sed -i 's|user  nginx;|# user nginx;|' /etc/nginx/nginx.conf || true
EXPOSE 9001
USER 1001
CMD ["nginx", "-g", "daemon off;"]
