! Managed by the platform: HybridFabric {{ fab_name }}, border gateway root instance. Changes here are overwritten.
frr version 8.5
frr defaults traditional
hostname {{ bgw_node.name }}
log syslog informational
service integrated-vtysh-config
!
! mpls enable mirrors the kernel's MPLS input (set by shc-fabric-apply): zebra shows it in the running config, so
! without it here a configuration reload would turn MPLS input off.
! The root is always the core LAN's designated IS (priority 127): a gateway that joined and won the election (equal
! priority, higher MAC) left FRR 8.5's LSPs on every node without the LAN's pseudonode, so no core routes, until the
! root restarted.
interface {{ hf_root.bridge }}
 ip router isis CORE
 isis priority 127
 mpls enable
exit
!
interface lo
 ip router isis CORE
 isis passive
 mpls enable
exit
!
! no graceful restart: when a gateway (a listen-range peer) is removed, FRR 8.5's restart timer for it still fired
! two minutes later on the deleted peer and bgpd aborted (every VPNv4 session down until watchfrr restarted it)
router bgp {{ fab_spec.domainAsn }}
 bgp router-id {{ hf_pe.loopbackIp }}
 bgp cluster-id {{ hf_pe.loopbackIp }}
 no bgp default ipv4-unicast
 bgp graceful-restart-disable
 neighbor PE peer-group
 neighbor PE remote-as {{ fab_spec.domainAsn }}
 neighbor PE update-source lo
 bgp listen range {{ fab_real.core.loopbackPool }} peer-group PE
 !
 address-family ipv4 vpn
  neighbor PE activate
  neighbor PE route-reflector-client
 exit-address-family
exit
!
{% if hf_node_egress.networks is defined %}
! provider internet egress: the hand-off's default route, and each network's NAT address back to its VRF
vrf {{ hf_node_egress.vrf }}
 ip route 0.0.0.0/0 {{ hf_node_egress.gateway }}
{% for n in hf_node_egress.networks %}
 ip route {{ n.nat }}/32 {{ n.xeIp }}
{% endfor %}
exit-vrf
!
{% for n in hf_node_egress.networks %}
vrf {{ n.vrf }}
 ip route 0.0.0.0/0 {{ n.xoIp }}
exit-vrf
!
{% endfor %}
ip prefix-list SHC-EGRESS-DEFAULT seq 5 permit 0.0.0.0/0
!
route-map SHC-EGRESS-DEFAULT permit 10
 match ip address prefix-list SHC-EGRESS-DEFAULT
exit
!
{% for n in hf_node_egress.networks %}
! HybridNetwork {{ n.network }}: internet egress (VPN {{ fab_spec.domainAsn }}:{{ n.vpnTarget }}, source NAT {{ n.nat }} on this node)
router bgp {{ fab_spec.domainAsn }} vrf {{ n.vrf }}
 bgp router-id {{ hf_pe.loopbackIp }}
 no bgp default ipv4-unicast
 !
 address-family ipv4 unicast
  redistribute static route-map SHC-EGRESS-DEFAULT
  label vpn export auto
  rd vpn export {{ n.rd or (hf_pe.loopbackIp ~ ':' ~ (n.vpnTarget | int % 65536)) }}
  rt vpn both {{ fab_spec.domainAsn }}:{{ n.vpnTarget }}
  nexthop vpn export {{ hf_pe.loopbackIp }}
  export vpn
  import vpn
 exit-address-family
exit
!
{% endfor %}
{% endif %}
router isis CORE
 is-type level-2-only
 net {{ hf_pe.net }}
 segment-routing on
 segment-routing global-block {{ fab_real.core.srgb.start }} {{ fab_real.core.srgb.end }}
 segment-routing prefix {{ hf_pe.loopback }} index {{ hf_pe.index }}
exit
!
