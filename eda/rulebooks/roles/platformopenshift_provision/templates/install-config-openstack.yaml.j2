apiVersion: v1
metadata:
  name: {{ cb_ocp_name }}
baseDomain: {{ cb_cluster_domain }}
# the installer's mode with floating IPs (both on a hybrid network and on a global external network)
publish: External
controlPlane:
  name: master
  replicas: {{ cb_control_plane_count }}
  platform:
    openstack:
      type: {{ cb_controller_flavor }}
compute:
- name: worker
  replicas: {{ cb_worker_count }}
  platform:
    openstack:
      type: {{ cb_worker_flavor }}
networking:
  networkType: OVNKubernetes
  clusterNetwork:
  - cidr: {{ cb_cluster_network }}
    hostPrefix: {{ cb_host_prefix }}
  machineNetwork:
  - cidr: {{ cb_machine_network }}
  serviceNetwork:
  - {{ cb_service_network }}
platform:
  openstack:
    cloud: openstack
    externalNetwork: {{ cb_external_network }}
    apiFloatingIP: {{ cb_api_vip }}
    ingressFloatingIP: {{ cb_ingress_vip }}
{% if cb_glance_image | default('') | length > 0 %}
    clusterOSImage: {{ cb_glance_image }}
{% endif %}
    externalDNS: {{ cb_external_dns | default([]) | to_json }}
{% if cb_trust_bundle | default('') | trim | length > 0 %}
additionalTrustBundle: |
{{ cb_trust_bundle | trim | indent(2, true) }}
{% endif %}
pullSecret: '{{ cb_pull_secret_json | to_json }}'
sshKey: '{{ cb_ssh_public_key | trim }}'
