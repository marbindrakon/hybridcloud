# Local cluster credentials (never commit)
.env

# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*secret*
*credential*
*token*
!**/templates/*secret*
!**/templates/*token*
# shc: Ansible role code named after what it handles (no secrets in it)
!ansible/roles/*/files/*token*.py
# Helm dependencies (downloaded by helm dependency build)
helm/charts/*/charts/*.tgz
