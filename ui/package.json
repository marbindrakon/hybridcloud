{
  "name": "@hybridsovereign/ui",
  "private": true,
  "version": "0.1.0",
  "description": "PatternFly 6 UI monorepo for Hybrid Sovereign Cloud dashboards and console plugins",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @hybridsovereign/shared",
    "build:admin-dashboard": "npm run build -w @hybridsovereign/admin-dashboard",
    "build:tenant-dashboard": "npm run build -w @hybridsovereign/tenant-dashboard",
    "build:admin-console-plugin": "npm run build -w @hybridsovereign/admin-console-plugin",
    "build:tenant-console-plugin": "npm run build -w @hybridsovereign/tenant-console-plugin",
    "dev:admin": "npm run dev -w @hybridsovereign/admin-dashboard",
    "dev:tenant": "npm run dev -w @hybridsovereign/tenant-dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck:baseline": "bash scripts/typecheck-baseline.sh --check",
    "test:shell": "bash scripts/test-shell.sh",
    "gen:console": "node scripts/gen-console-extensions.mjs",
    "check:console": "node scripts/gen-console-extensions.mjs --check",
    "gen:role-hints": "python3 -I scripts/gen-role-hints.py"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
