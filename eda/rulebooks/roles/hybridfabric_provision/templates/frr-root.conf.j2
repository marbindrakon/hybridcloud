{% set _v6 = hf_pe.loopback6 | default('') | length > 0 %}
{# the node's core transport: MPLS L3VPN over IS-IS segment routing (mpls) or SRv6 L3VPN over the IPv6 core (srv6);
   the FRR major version picks the text form the daemons print back, which frr-reload compares #}
{% set _srv6 = (fab_node_transport | default('mpls')) == 'srv6' %}
{% set _frr10 = (fab_frr_major | default(8)) | int >= 10 %}
! Managed by the platform: HybridFabric {{ fab_name }}, border gateway root instance. Changes here are overwritten.
frr version 8.5
frr defaults traditional
hostname {{ bgw_node.name }}
log syslog informational
service integrated-vtysh-config
!
{% if _srv6 %}
! SRv6 core: the root is a provider edge for the egress and circuit VRFs, so it has a locator of its own for their
! SIDs. IS-IS announces the locator as a prefix of lo (passive): shc-fabric-apply holds the locator's first address
! there with the locator's length, and blackholes the locator, so a packet for an unused SID is dropped here (the SIDs
! inside it are longer routes)
! the locator as micro-SIDs (32-bit block, 16-bit node, 16-bit function), in the form this FRR version prints back
{% if _frr10 %}
! (it also shows the kernel's encapsulation source, set by shc-fabric-apply: without it a reload would remove it)
{% endif %}
segment-routing
 srv6
{% if _frr10 %}
  encapsulation
   source-address {{ hf_pe.loopbackIp6 }}
  exit
{% endif %}
  locators
   locator MAIN
{% if _frr10 %}
    prefix {{ hf_pe.locator }} block-len 32 node-len 16
{% else %}
    prefix {{ hf_pe.locator }} block-len 32 node-len 16 func-bits 16
{% endif %}
    behavior usid
   exit
  exit
 exit
exit
!
{% else %}
! mpls enable mirrors the kernel's MPLS input (set by shc-fabric-apply): zebra shows it in the running config, so
! without it here a configuration reload would turn MPLS input off.
{% endif %}
! The root is always the core LAN's designated IS (priority 127): a gateway that joined and won the election (equal
! priority, higher MAC) left FRR 8.5's LSPs on every node without the LAN's pseudonode, so no core routes, until the
! root restarted.
interface {{ hf_root.bridge }}
 ip router isis CORE
{% if _v6 %}
 ipv6 router isis CORE
{% endif %}
 isis priority 127
{% if not _srv6 %}
 mpls enable
{% endif %}
exit
!
interface lo
 ip router isis CORE
{% if _v6 %}
 ipv6 router isis CORE
{% endif %}
 isis passive
{% if not _srv6 %}
 mpls enable
{% endif %}
exit
!
! no graceful restart: when a gateway (a listen-range peer) is removed, FRR 8.5's restart timer for it still fired
! two minutes later on the deleted peer and bgpd aborted (every VPNv4 session down until watchfrr restarted it)
router bgp {{ fab_spec.domainAsn }}
 bgp router-id {{ hf_pe.loopbackIp }}
 bgp cluster-id {{ hf_pe.loopbackIp }}
 no bgp default ipv4-unicast
 bgp graceful-restart-disable
 neighbor PE peer-group
 neighbor PE remote-as {{ fab_spec.domainAsn }}
{% if _srv6 %}
{# SRv6: the gateways' VPN sessions come from their IPv6 loopbacks, and the extended next hop lets the IPv4 VPN
   routes carry an IPv6 loopback as next hop (an SRv6 SID is only reached over IPv6). The root's own VRFs take their
   SIDs from locator MAIN #}
 neighbor PE update-source {{ hf_pe.loopbackIp6 }}
 neighbor PE capability extended-nexthop
 bgp listen range {{ fab_real.core.loopbackPool6 }} peer-group PE
 !
 segment-routing srv6
  locator MAIN
 exit
{% else %}
 neighbor PE update-source lo
 bgp listen range {{ fab_real.core.loopbackPool }} peer-group PE
{% endif %}
 !
 address-family ipv4 vpn
  neighbor PE activate
  neighbor PE route-reflector-client
 exit-address-family
{% set _e6 = hf_node_egress.ipv6 if (_v6 and hf_node_egress.ipv6 is defined) else none %}
{% set _n6 = (hf_node_egress.networks | selectattr('ipv6', 'defined') | list) if _e6 else [] %}
{% if _v6 %}
 !
{# the IPv6 VPN routes ride the same sessions (IPv4 loopbacks), with the provider edges' IPv6 loopbacks as next hops.
   With IPv6 egress the reflector drops a default route a gateway sends (a gateway's own unreachable default, meant for
   its site only, has an empty AS path and would beat the egress default everywhere) #}
 address-family ipv6 vpn
  neighbor PE activate
  neighbor PE route-reflector-client
{% if _e6 %}
  neighbor PE route-map SHC-RR-IN6 in
{% endif %}
 exit-address-family
{% endif %}
exit
!
{# the service VRF on this node (service-plan nodes; absent: none) and the service link of each network VRF #}
{% set _svc = hf_node_service | default({}, true) %}
{% set _svc_by_vrf = {} %}
{% for v in hf_node_vrfs if v.service is defined %}{% set _ = _svc_by_vrf.update({v.vrf: v.service}) %}{% endfor %}
{% if hf_node_egress.networks is defined %}
{# (the second line names the platform reach of an earlier release, retired; kept as it was, so the file of a node
   without the service VRF stays byte for byte what it was) #}
! provider internet egress: the hand-off's default route, and each network's NAT address back to its VRF;
! platform reach: each network's platform prefixes towards its VRF, and the platform's sources back to the hand-off
{% if _e6 %}
! IPv6 internet egress: the platform's routed space is discarded here and in every network VRF (the placement
! prefixes learned from the networks are longer), so unallocated space never loops between the upstream and the node
{% endif %}
{# with core.icmpSource4 the routes back to the networks (each NAT address, each platform prefix) take this node's
   hand-off address as their source, so the egress VRF's "time exceeded" and "fragmentation needed" toward a network
   leave from it, never from the egress veth's link-local address. Not core.icmpSource4 itself: the network's VRF holds
   that address as a local one, and the kernel drops a packet arriving there with a local source (martian source) #}
{% set _src4 = ((fab_real | default({}, true)).core | default({}, true)).icmpSource4 | default('', true) | replace('/32', '') %}
{% set _nets4 = [] %}
{% for n in hf_node_egress.networks %}
{% if n.nat | default('') %}{% set _ = _nets4.append(n.nat ~ '/32') %}{% endif %}
{% endfor %}
vrf {{ hf_node_egress.vrf }}
{% if _src4 and _nets4 %}
 ip protocol static route-map SHC-EGRESS-SRC4
{% endif %}
 ip route 0.0.0.0/0 {{ hf_node_egress.gateway }}
{% for n in hf_node_egress.networks %}
{% if n.nat | default('') %}
 ip route {{ n.nat }}/32 {{ n.xeIp }}
{% endif %}
{% endfor %}
{% for r in (_e6.routed if _e6 else []) %}
 ipv6 route {{ r }} reject 254
{% endfor %}
exit-vrf
!
{% for n in hf_node_egress.networks %}
vrf {{ n.vrf }}
{% if n.internet | default(true) %}
 ip route 0.0.0.0/0 {{ n.xoIp }}
{% endif %}
{% if n.vrf in _svc_by_vrf %}
{% for h in _svc.hub %}
 ip route {{ h }} reject 254
{% endfor %}
{% endif %}
{% if _e6 and n.ipv6 is defined %}
{% for r in _e6.routed %}
 ipv6 route {{ r }} reject 254
{% endfor %}
{% endif %}
exit-vrf
!
{% endfor %}
ip prefix-list SHC-EGRESS-DEFAULT seq 5 permit 0.0.0.0/0
!
route-map SHC-EGRESS-DEFAULT permit 10
 match ip address prefix-list SHC-EGRESS-DEFAULT
exit
!
{% if _src4 and _nets4 %}
{% for p in _nets4 | unique %}
ip prefix-list SHC-EGRESS-NETS4 seq {{ loop.index * 5 }} permit {{ p }}
{% endfor %}
route-map SHC-EGRESS-SRC4 permit 10
 match ip address prefix-list SHC-EGRESS-NETS4
 set src {{ hf_node_egress.address.split('/')[0] }}
exit
route-map SHC-EGRESS-SRC4 permit 20
exit
!
{% endif %}
{% endif %}
{% if _e6 %}
{# IPv6 internet egress (AS _e6.asn, IPV6-PLAN §3.2): the egress VRF takes the default route from the upstream routers
   (and the external site prefixes) and sends them the placement prefixes inside the routed space, prepended for the
   networks this node is the standby of; each network's VRF takes the default over its veth and sends exactly its
   placement prefixes; into the network's VPN goes the default only (the aggregates stay in the VRF), marked with the
   standby community on the standby node. frr defaults traditional: every eBGP session carries both route-maps #}
ipv6 prefix-list SHC-DEFAULT6 seq 5 permit ::/0
{% for r in _e6.routed %}
ipv6 prefix-list SHC-ROUTED6 seq {{ loop.index * 5 }} permit {{ r }} ge {{ r.split('/')[1] | int + 1 }} le 64
{% endfor %}
{% for p in _e6.external6 | default([]) %}
ipv6 prefix-list SHC-EXTERNAL6 seq {{ loop.index * 5 }} permit {{ p }}
{% endfor %}
{% set _sb = [] %}
{% for n in _n6 if n.ipv6.standby %}{% for p in n.ipv6.prefixes %}{% set _ = _sb.append(p) %}{% endfor %}{% endfor %}
{% for p in _sb %}
ipv6 prefix-list SHC-EGRESS-STANDBY6 seq {{ loop.index * 5 }} permit {{ p }}
{% endfor %}
{% for n in _n6 %}
{% for p in n.ipv6.prefixes %}
ipv6 prefix-list E{{ n.vpnTarget }}-PL6 seq {{ loop.index * 5 }} permit {{ p }}
{% else %}
ipv6 prefix-list E{{ n.vpnTarget }}-PL6 seq 5 deny ::/0 le 128
{% endfor %}
{% endfor %}
!
route-map SHC-RR-IN6 deny 10
 match ipv6 address prefix-list SHC-DEFAULT6
exit
route-map SHC-RR-IN6 permit 20
exit
route-map SHC-EGRESS-FROM-UP6 permit 10
 match ipv6 address prefix-list SHC-DEFAULT6
exit
{% if _e6.external6 | default([]) %}
route-map SHC-EGRESS-FROM-UP6 permit 20
 match ipv6 address prefix-list SHC-EXTERNAL6
exit
{% endif %}
{% if _sb %}
route-map SHC-EGRESS-TO-UP6 permit 10
 match ipv6 address prefix-list SHC-EGRESS-STANDBY6
 set as-path prepend {{ ([_e6.asn] * (_e6.standbyPrepend | int)) | join(' ') }}
exit
{% endif %}
route-map SHC-EGRESS-TO-UP6 permit 20
 match ipv6 address prefix-list SHC-ROUTED6
exit
route-map SHC-EGRESS-FROM-NET6 permit 10
 match ipv6 address prefix-list SHC-ROUTED6
exit
route-map SHC-EGRESS-TO-NET6 permit 10
 match ipv6 address prefix-list SHC-DEFAULT6
exit
{% for n in _n6 %}
route-map E{{ n.vpnTarget }}-FROM-EG6 permit 10
 match ipv6 address prefix-list SHC-DEFAULT6
exit
route-map E{{ n.vpnTarget }}-TO-EG6 permit 10
 match ipv6 address prefix-list E{{ n.vpnTarget }}-PL6
exit
route-map E{{ n.vpnTarget }}-VPN6 deny 5
 match ipv6 address prefix-list E{{ n.vpnTarget }}-PL6
exit
route-map E{{ n.vpnTarget }}-VPN6 permit 10
 match ipv6 address prefix-list SHC-DEFAULT6
{% if n.ipv6.standby %}
 set community {{ fab_spec.domainAsn }}:{{ _e6.standbyCommunity }} additive
{% endif %}
exit
route-map E{{ n.vpnTarget }}-VPN6 permit 20
exit
route-map E{{ n.vpnTarget }}-IMPORT6 deny 5
 match ipv6 address prefix-list SHC-DEFAULT6
exit
route-map E{{ n.vpnTarget }}-IMPORT6 permit 10
exit
{% endfor %}
!
{% endif %}
{% if _svc %}
{# the service VRF (no VPN, no route target, no SID or label): the hub's routes from the platform circuits (eBGP,
   only the hub's ranges), a route to each accepted prefix of a network over its service link, announced to the hub
   (only the accepted prefixes, only inside the attachable ranges). Each network with clusters learns the hub's
   ranges from the service VRF over its service link (iBGP, the network VRF connecting, the service VRF passive):
   only while this node holds them from a platform circuit, so a node whose circuits are all down withdraws them from
   the network's VPN and the sites return the clusters' traffic to a node that can deliver it. A reject route at
   distance 254 keeps the hub's ranges off any other route of the network (its internet egress default) while
   neither node has them. Nothing else of the service VRF reaches a network VRF, so no route crosses between tenant
   networks #}
! the service VRF {{ _svc.vrf }}: the platform's management (the hub, {{ _svc.hub | join(', ') }}) reaches the clusters the
! platform builds on tenant networks; handed off to the hub's network by the platform circuits
{% for v in hf_node_vrfs if v.service is defined and not v.egress %}
vrf {{ v.vrf }}
{% for h in _svc.hub %}
 ip route {{ h }} reject 254
{% endfor %}
exit-vrf
!
{% endfor %}
{% set _svc_routes = [] %}
{% for w in _svc.networks %}{% for p in w.prefixes %}{% set _ = _svc_routes.append([p, w.seIp]) %}{% endfor %}{% endfor %}
{% if _svc_routes %}
vrf {{ _svc.vrf }}
{% for r in _svc_routes %}
 ip route {{ r[0] }} {{ r[1] }}
{% endfor %}
exit-vrf
!
{% endif %}
{% for h in _svc.hub %}
ip prefix-list SHC-HUB4 seq {{ loop.index * 5 }} permit {{ h }} le 32
{% endfor %}
!
route-map SVC-NET-IN permit 10
 match ip address prefix-list SHC-HUB4
 set weight 100
exit
route-map SVC-NET-OUT deny 10
exit
route-map SVC-TO-NET permit 10
 match ip address prefix-list SHC-HUB4
exit
route-map SVC-FROM-NET deny 10
exit
!
{% for e in _svc.accept %}
ip prefix-list SVC-HUB seq {{ loop.index * 5 }} permit {{ e }}
{% endfor %}
{% for e in _svc.deny %}
ip prefix-list SVC-DENY seq {{ loop.index * 5 }} permit {{ e }}
{% endfor %}
{% for e in _svc.advertise %}
ip prefix-list SVC-ACCEPTED seq {{ loop.index * 5 }} permit {{ e }}
{% else %}
ip prefix-list SVC-ACCEPTED seq 5 deny 0.0.0.0/0 le 32
{% endfor %}
{% for e in _svc.attachable %}
ip prefix-list SVC-ATTACHABLE seq {{ loop.index * 5 }} permit {{ e }}
{% endfor %}
!
route-map SVC-STATIC permit 10
 match ip address prefix-list SVC-ATTACHABLE
exit
!
{% for c in _svc.circuits %}
! platform circuit {{ c.circuit }} (VLAN {{ c.vlan }}, CE {{ c.ce }} AS {{ c.peerAsn }}): the hub's ranges in, the
! accepted cluster prefixes out. The hub's routes enter without the hub router's own AS number and without any
! community (a route target among them would import them into another network's VRF; no-export or no-advertise would
! keep them from the networks)
route-map {{ c.id }}-IN deny 10
 match ip address prefix-list SVC-DENY
exit
route-map {{ c.id }}-IN permit 20
 match ip address prefix-list SVC-HUB
 set as-path exclude {{ c.peerAsn }}
 set community none
 set extcommunity none
 set large-community none
exit
{% if _svc.advertise %}
route-map {{ c.id }}-OUT permit 10
 match ip address prefix-list SVC-ACCEPTED
exit
{% else %}
route-map {{ c.id }}-OUT deny 10
exit
{% endif %}
!
{% endfor %}
{# its own router ID (the node's address on its first platform circuit): the network VRFs, with the loopback as
   theirs, peer with it #}
router bgp {{ fab_spec.domainAsn }} vrf {{ _svc.vrf }}
 bgp router-id {{ _svc.circuits[0].ip }}
 no bgp default ipv4-unicast
{% for w in _svc.networks %}
 neighbor {{ w.seIp }} remote-as {{ fab_spec.domainAsn }}
 neighbor {{ w.seIp }} description service link of {{ w.network }}
 neighbor {{ w.seIp }} ttl-security hops 1
 neighbor {{ w.seIp }} passive
 neighbor {{ w.seIp }} timers 10 30
{% endfor %}
{% for c in _svc.circuits %}
 neighbor {{ c.ce }} remote-as {{ c.peerAsn }}
 neighbor {{ c.ce }} description {{ c.id }} {{ c.circuit }}
{% if c.authentication == 'md5' %}
 neighbor {{ c.ce }} password {{ hf_circuit_passwords[c.circuit] }}
{% endif %}
 neighbor {{ c.ce }} timers 10 30
{% if c.bfd %}
 neighbor {{ c.ce }} bfd
{% endif %}
{% endfor %}
 !
 address-family ipv4 unicast
  redistribute static route-map SVC-STATIC
{% for c in _svc.circuits %}
  neighbor {{ c.ce }} activate
  neighbor {{ c.ce }} route-map {{ c.id }}-IN in
  neighbor {{ c.ce }} route-map {{ c.id }}-OUT out
  neighbor {{ c.ce }} maximum-prefix {{ c.maxPrefixes }}{{ ' warning-only' if c.maxPrefixAction == 'warning' else (' restart ' ~ hf_attach_restart if hf_attach_restart | int > 0 else '') }}
{% endfor %}
{% for w in _svc.networks %}
  neighbor {{ w.seIp }} activate
  neighbor {{ w.seIp }} next-hop-self
  neighbor {{ w.seIp }} route-map SVC-FROM-NET in
  neighbor {{ w.seIp }} route-map SVC-TO-NET out
{% endfor %}
 exit-address-family
exit
!
{% endif %}
{% for v in hf_node_vrfs %}
{% for c in v.circuits %}
! AttachmentCircuit {{ c.circuit }} (VLAN {{ c.vlan }}, CE {{ c.ce }} AS {{ c.peerAsn }}): routes from the CE in the
! accept list and outside the deny list; to the CE the network's placement prefixes{{ ' and the default route' if c.advertiseDefault else '' }}
{# an accept list without IPv4 entries (all of them IPv6) admits nothing, explicitly: a route-map entry that names a
   missing prefix-list must never be read as "permit" #}
{% for e in c.accept %}
ip prefix-list {{ c.id }}-ACCEPT seq {{ loop.index * 5 }} permit {{ e }}
{% else %}
ip prefix-list {{ c.id }}-ACCEPT seq 5 deny 0.0.0.0/0 le 32
{% endfor %}
{% for e in c.deny %}
ip prefix-list {{ c.id }}-DENY seq {{ loop.index * 5 }} permit {{ e }}
{% endfor %}
{% for e in c.advertise %}
ip prefix-list {{ c.id }}-OUT seq {{ loop.index * 5 }} permit {{ e }}
{% endfor %}
!
route-map {{ c.id }}-IN deny 10
 match ip address prefix-list {{ c.id }}-DENY
exit
!
route-map {{ c.id }}-IN permit 20
 match ip address prefix-list {{ c.id }}-ACCEPT
exit
!
{% if c.advertise %}
route-map {{ c.id }}-OUT permit 10
 match ip address prefix-list {{ c.id }}-OUT
exit
{% else %}
route-map {{ c.id }}-OUT deny 10
exit
{% endif %}
!
{% if c.ipv6 is defined %}
! AttachmentCircuit {{ c.circuit }} over IPv6 (link {{ c.ipv6.link }}, CE {{ c.ipv6.ce }}): the same rules from the
! IPv6 lists; to the CE the network's IPv6 placement prefixes{{ ' and the default route' if c.ipv6.advertiseDefault else '' }}
{% for e in c.ipv6.accept %}
ipv6 prefix-list {{ c.id }}-ACCEPT6 seq {{ loop.index * 5 }} permit {{ e }}
{% else %}
ipv6 prefix-list {{ c.id }}-ACCEPT6 seq 5 deny ::/0 le 128
{% endfor %}
{% for e in c.ipv6.deny %}
ipv6 prefix-list {{ c.id }}-DENY6 seq {{ loop.index * 5 }} permit {{ e }}
{% endfor %}
{% for e in c.ipv6.advertise %}
ipv6 prefix-list {{ c.id }}-OUT6 seq {{ loop.index * 5 }} permit {{ e }}
{% endfor %}
!
route-map {{ c.id }}-IN6 deny 10
 match ipv6 address prefix-list {{ c.id }}-DENY6
exit
!
route-map {{ c.id }}-IN6 permit 20
 match ipv6 address prefix-list {{ c.id }}-ACCEPT6
exit
!
{% if c.ipv6.advertise %}
route-map {{ c.id }}-OUT6 permit 10
 match ipv6 address prefix-list {{ c.id }}-OUT6
exit
{% else %}
route-map {{ c.id }}-OUT6 deny 10
exit
{% endif %}
!
{% endif %}
{% endfor %}
{% endfor %}
{% for n in hf_node_vrfs %}
{% set _fam = n.families | default([4]) | map('int') | list %}
! HybridNetwork {{ n.network }}: {{ ('internet egress (source NAT ' ~ n.nat ~ ' on this node)') if n.nat | default('') else '' }}{{ ((' ' if n.egress else '') ~ 'attachment circuits ' ~ n.circuits | map(attribute='id') | join(',')) if n.circuits else '' }}{{ (((' ' if n.egress or n.circuits else '') ~ 'clusters the platform reaches (' ~ n.service.prefixes | join(',') ~ ')')) if n.service is defined else '' }}{{ (' IPv6 internet egress (' ~ ('standby' if n.ipv6.standby else 'primary') ~ ' node)') if (_e6 and n.ipv6 is defined) else '' }} (VPN {{ fab_spec.domainAsn }}:{{ n.vpnTarget }})
router bgp {{ fab_spec.domainAsn }} vrf {{ n.vrf }}
 bgp router-id {{ hf_pe.loopbackIp }}
 no bgp default ipv4-unicast
{% if _srv6 and (4 in _fam or (_e6 and n.ipv6 is defined) or n.circuits | selectattr('ipv6', 'defined') | list) %}
{#- SRv6: one SID for the VRF and both address families (decapsulation into the VRF's table, IPv4 or IPv6 inside),
    in place of a label per family #}
 sid vpn per-vrf export auto
{% endif %}
{% if _e6 and n.ipv6 is defined %}
{# v6only: the veth also carries the IPv4 /31 of the IPv4 egress, and FRR would peer over it (the IPv4 filter drops
   that); the session stays on the link-local addresses the router advertisements exchange #}
 neighbor {{ n.xe }} interface v6only remote-as external
 neighbor {{ n.xe }} description IPv6 egress of {{ n.network }}
{% endif %}
{% if n.service is defined %}
 neighbor {{ n.service.soIp }} remote-as {{ fab_spec.domainAsn }}
 neighbor {{ n.service.soIp }} description the hub's routes from the service VRF
 neighbor {{ n.service.soIp }} ttl-security hops 1
 neighbor {{ n.service.soIp }} timers 10 30
{% endif %}
{% for c in n.circuits %}
 neighbor {{ c.ce }} remote-as {{ c.peerAsn }}
 neighbor {{ c.ce }} description {{ c.id }} {{ c.circuit }}
{% if c.authentication == 'md5' %}
 neighbor {{ c.ce }} password {{ hf_circuit_passwords[c.circuit] }}
{% endif %}
 neighbor {{ c.ce }} timers 10 30
{% if c.bfd %}
 neighbor {{ c.ce }} bfd
{% endif %}
{% if c.ipv6 is defined %}
{# the circuit's IPv6 session: a neighbour of its own on the IPv6 link with the same AS, password, timers and BFD. It
   carries only IPv6 routes, as the IPv4 neighbour carries only IPv4 routes: each is activated in its own family #}
 neighbor {{ c.ipv6.ce }} remote-as {{ c.peerAsn }}
 neighbor {{ c.ipv6.ce }} description {{ c.id }}6 {{ c.circuit }}
{% if c.authentication == 'md5' %}
 neighbor {{ c.ipv6.ce }} password {{ hf_circuit_passwords[c.circuit] }}
{% endif %}
 neighbor {{ c.ipv6.ce }} timers 10 30
{% if c.bfd %}
 neighbor {{ c.ipv6.ce }} bfd
{% endif %}
{% endif %}
{% endfor %}
{% if 4 in _fam %}
 !
 address-family ipv4 unicast
{% if n.egress %}
  redistribute static route-map SHC-EGRESS-DEFAULT
{% endif %}
{% if n.service is defined %}
  neighbor {{ n.service.soIp }} activate
  neighbor {{ n.service.soIp }} route-map SVC-NET-IN in
  neighbor {{ n.service.soIp }} route-map SVC-NET-OUT out
{% endif %}
{# no soft-reconfiguration inbound: the routes the policy rejects would be kept, and maximum-prefix doesn't bound
   them (a CE could fill the node's memory); a policy change asks the CE to send its routes again (route refresh) #}
{% for c in n.circuits %}
  neighbor {{ c.ce }} activate
  neighbor {{ c.ce }} route-map {{ c.id }}-IN in
  neighbor {{ c.ce }} route-map {{ c.id }}-OUT out
  neighbor {{ c.ce }} maximum-prefix {{ c.maxPrefixes }}{{ ' warning-only' if c.maxPrefixAction == 'warning' else (' restart ' ~ hf_attach_restart if hf_attach_restart | int > 0 else '') }}
{% endfor %}
{% if not _srv6 %}
  label vpn export auto
{% endif %}
  rd vpn export {{ n.rd or (hf_pe.loopbackIp ~ ':' ~ (n.vpnTarget | int % 65536)) }}
  rt vpn both {{ fab_spec.domainAsn }}:{{ n.vpnTarget }}
{# FRR tracks an exported BGP route's next hop inside the VRF, where the loopback is unknown: with a CE's routes
   (or the hub's, learned over the service link) in the VRF, the VPN routes keep their own next hop (announced as the
   node's own address) #}
{#- SRv6: the same rule, with the IPv6 loopback where a next hop is set (the SID is reached over IPv6); where none is
    set the routes go out with the session's local address, the IPv6 loopback, as next hop (extended next hop) #}
{% if not n.circuits and n.service is not defined %}
  nexthop vpn export {{ hf_pe.loopbackIp6 if _srv6 else hf_pe.loopbackIp }}
{% endif %}
  export vpn
  import vpn
 exit-address-family
{% endif %}
{% set _eg6 = (_e6 and n.ipv6 is defined) | bool %}
{% set _c6 = n.circuits | selectattr('ipv6', 'defined') | list %}
{% if _eg6 or _c6 %}
 !
{% if _eg6 %}
{# the network's IPv6 side: the default route from the egress VRF over the veth (into the VPN with the IPv6 loopback
   as next hop, as the gateways do), and toward the egress VRF exactly the placement prefixes, each originated here as
   an aggregate of the routes the sites send (active only while a route inside it exists) #}
{% else %}
{# the network's IPv6 side for its circuits alone (no IPv6 egress): the CEs' routes into the network's VPN and the
   VPN's routes to the CEs, through the circuits' route-maps #}
{% endif %}
 address-family ipv6 unicast
{% if _eg6 %}
{% for p in n.ipv6.prefixes %}
  aggregate-address {{ p }}
{% endfor %}
  neighbor {{ n.xe }} activate
  neighbor {{ n.xe }} route-map E{{ n.vpnTarget }}-FROM-EG6 in
  neighbor {{ n.xe }} route-map E{{ n.vpnTarget }}-TO-EG6 out
  neighbor {{ n.xe }} maximum-prefix {{ _e6.maxPrefixesUpstream }}
{% endif %}
{% for c in _c6 %}
  neighbor {{ c.ipv6.ce }} activate
  neighbor {{ c.ipv6.ce }} route-map {{ c.id }}-IN6 in
  neighbor {{ c.ipv6.ce }} route-map {{ c.id }}-OUT6 out
  neighbor {{ c.ipv6.ce }} maximum-prefix {{ c.maxPrefixes }}{{ ' warning-only' if c.maxPrefixAction == 'warning' else (' restart ' ~ hf_attach_restart if hf_attach_restart | int > 0 else '') }}
{% endfor %}
{% if not _srv6 %}
  label vpn export auto
{% endif %}
  rd vpn export {{ n.rd or (hf_pe.loopbackIp ~ ':' ~ (n.vpnTarget | int % 65536)) }}
  rt vpn both {{ fab_spec.domainAsn }}:{{ n.vpnTarget }}
{# no nexthop vpn export once a CE's IPv6 routes are in the VRF (the IPv4 rule above, for the same reason): with
   it set, FRR 8.5 resolves that next hop inside the VRF, where the loopback is no route (a circuit-only network's
   VRF holds nothing that covers it), and the CE's routes stay invalid in the VPN table. Without it every route is
   exported with the node itself as next hop, which FRR announces as the global IPv6 address of the sessions'
   update source lo: the IPv6 loopback. Spike S1 case C ran exactly this VRF (CE and egress veth, no nexthop vpn
   export, dual-stack core) on FRR 8.5.3 and 10.4: the CE's routes reached the far PE valid, with the loopback as
   next hop and a labelled kernel route, and so did the egress default. An IPv4 next hop would be wrong (no
   labelled IPv6 route over an IPv4 next hop, and it invalidated the default learned over the veth). Without
   circuits the IPv6 egress keeps its explicit next hop, unchanged #}
{% if not _c6 %}
  nexthop vpn export {{ hf_pe.loopbackIp6 }}
{% endif %}
{% if _eg6 %}
  route-map vpn export E{{ n.vpnTarget }}-VPN6
  route-map vpn import E{{ n.vpnTarget }}-IMPORT6
{% endif %}
  export vpn
  import vpn
 exit-address-family
{% endif %}
exit
!
{% endfor %}
{% if _e6 %}
! the egress VRF (AS {{ _e6.asn }}): single-hop eBGP to the upstream routers (in: the default route; out: the placement
! prefixes, prepended for the networks this node is the standby of) and unnumbered eBGP to each network's VRF over
! its veth (in: its placement prefixes; out: the default route). Timers 10/30, no BFD, no password.
router bgp {{ _e6.asn }} vrf {{ hf_node_egress.vrf }}
 bgp router-id {{ hf_node_egress.address.split('/')[0] }}
 no bgp default ipv4-unicast
 bgp graceful-restart-disable
{% for n in _n6 %}
 neighbor {{ n.xo }} interface v6only remote-as external
 neighbor {{ n.xo }} description IPv6 egress of {{ n.network }}
{% endfor %}
{% for u in _e6.upstream %}
 neighbor {{ u.address }} remote-as {{ u.asn }}
 neighbor {{ u.address }} description upstream
 neighbor {{ u.address }} timers 10 30
 neighbor {{ u.address }} timers connect 5
{% endfor %}
 !
 address-family ipv6 unicast
{% for n in _n6 %}
  neighbor {{ n.xo }} activate
  neighbor {{ n.xo }} route-map SHC-EGRESS-FROM-NET6 in
  neighbor {{ n.xo }} route-map SHC-EGRESS-TO-NET6 out
  neighbor {{ n.xo }} maximum-prefix {{ _e6.maxPrefixesNetwork }}
{% endfor %}
{% for u in _e6.upstream %}
  neighbor {{ u.address }} activate
  neighbor {{ u.address }} route-map SHC-EGRESS-FROM-UP6 in
  neighbor {{ u.address }} route-map SHC-EGRESS-TO-UP6 out
  neighbor {{ u.address }} maximum-prefix {{ _e6.maxPrefixesUpstream }}
{% endfor %}
 exit-address-family
exit
!
{% endif %}
router isis CORE
 is-type level-2-only
 net {{ hf_pe.net }}
{# SRv6: no segment routing in the IGP and no redistribution; it carries the prefixes of lo, the loopbacks and the
   locator #}
{% if not _srv6 %}
 segment-routing on
 segment-routing global-block {{ fab_real.core.srgb.start }} {{ fab_real.core.srgb.end }}
 segment-routing prefix {{ hf_pe.loopback }} index {{ hf_pe.index }}
{% if _v6 %}
 segment-routing prefix {{ hf_pe.loopback6 }} index {{ hf_pe.index | int + fab_real.core.sidOffset6 | default(1000) | int }}
{% endif %}
{% endif %}
exit
!
