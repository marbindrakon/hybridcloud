---
# shc (design/P11-GCP-PLAN.md §3.6): mce-cluster-build values of a Google Cloud cluster with workload identity
# federation, no keys. Hive's provider credentials Secret holds an external-account credential configuration (the
# install pod's own token at the hub's pool, impersonating the project's member account); the signing key and the
# install manifests come from Vault; the cluster is imported into the hub by the post-install.
cluster:
  name: {{ cb_app_name }}
  clusterName: {{ cb_ocp_name }}
  importToHub: false
  useACM: false
  createGitopsManifestWorks: false
  createGitopsSyncSet: false
  type: ocp
  baseDomain: "{{ cb_install_base_domain }}"
  clusterImageSet: "{{ cb_image_set }}"
  controlPlaneCount: {{ cb_control_plane_count }}
  workerCount: {{ cb_worker_count }}
  infraCount: 0
  apiVIP: ""
  ingressVIP: ""
  pullSecretVault: "{{ cb_pull_secret_vault }}"
  pullSecretVaultProperty: "{{ cb_pull_secret_vault_property }}"
  sshKeyVault: "{{ cb_ssh_key_vault }}"
  trustedCAs: ""
  sshPubKey: ""
  dnsServers: []

provider:
  type: GCP
  providerCredsVault: "{{ cb_provider_creds_vault }}"
  providerCAs: ""
  gcp:
    region: "{{ cb_region }}"
    controllerFlavor: "{{ cb_controller_flavor }}"
    workerFlavor: "{{ cb_worker_flavor }}"
    serviceAccountSignerSecret: "{{ cb_signer_vault }}"
    extraManifestsSecret: "{{ cb_manifests_vault }}"

installConfigVault: "{{ cb_install_config_vault }}"

secretStoreName: vault-backend
