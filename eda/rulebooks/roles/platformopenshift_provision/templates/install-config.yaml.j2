apiVersion: v1
metadata:
  name: {{ cb_ocp_name }}
baseDomain: {{ cb_install_base_domain }}
publish: {{ aws_publish | default('External') }}
# shc (design/P8-PLAN.md §12): STS - the operators' credentials come from the install's manifests (role ARNs and
# projected service-account tokens of the cluster's own issuer); Hive's credentials are temporary and stay outside
credentialsMode: Manual
controlPlane:
  hyperthreading: Enabled
  name: master
  replicas: {{ cb_control_plane_count }}
  platform:
    aws:
      type: {{ cb_controller_flavor }}
      rootVolume:
        size: 120
        type: gp3
compute:
- hyperthreading: Enabled
  name: worker
  replicas: {{ cb_worker_count }}
  platform:
    aws:
      type: {{ cb_worker_flavor }}
      rootVolume:
        size: 120
        type: gp3
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  machineNetwork:
  - cidr: {{ cb_machine_cidr | default('10.0.0.0/16') }}
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16
platform:
  aws:
    region: {{ cb_region }}
    userTags:
      shc-managed: "true"
      shc-build: {{ cb_app_name }}
{% if cb_subnet_ids | default([]) %}
    # a hybrid network's placement (P8 §13): its subnets with explicit roles (the VPC also holds the network's
    # attachment subnets); NLBs for API and ingress
    lbType: NLB
    vpc:
      subnets:
{% for id in cb_subnet_ids %}
      - id: {{ id }}
        roles:
{% if aws_publish | default('External') == 'Internal' %}
        - type: ClusterNode
        - type: BootstrapNode
        - type: ControlPlaneInternalLB
        - type: IngressControllerLB
{% else %}
        - type: ClusterNode
        - type: ControlPlaneInternalLB
{% endif %}
{% endfor %}
{% for id in cb_public_subnet_ids | default([]) %}
      - id: {{ id }}
        roles:
        - type: BootstrapNode
        - type: ControlPlaneExternalLB
        - type: IngressControllerLB
{% endfor %}
{% endif %}
pullSecret: '{{ cb_pull_secret_json | to_json }}'
sshKey: '{{ cb_ssh_public_key | trim }}'
